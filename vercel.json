{
  "functions": {
    "api/hub-page.js": {
      "includeFiles": "api/_hub/**"
    },
    "api/storysculpt.js": {
      "includeFiles": "api/_hub/storysculpt-src/**"
    }
  },
  "crons": [
    {
      "path": "/api/certainty-reminders",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
    },
    {
      "source": "/analytics/",
      "destination": "/analytics.html"
    },
    {
      "source": "/momentum300",
      "destination": "/momentum300.html"
    },
    {
      "source": "/momentum300/",
      "destination": "/momentum300.html"
    },
    {
      "source": "/todo",
      "destination": "/todo.html"
    },
    {
      "source": "/todo/",
      "destination": "/todo.html"
    },
    {
      "source": "/eee",
      "destination": "/api/hub-page?tool=eee"
    },
    {
      "source": "/eee/",
      "destination": "/api/hub-page?tool=eee"
    },
    {
      "source": "/storysculpt",
      "destination": "/api/hub-page?tool=storysculpt"
    },
    {
      "source": "/storysculpt/",
      "destination": "/api/hub-page?tool=storysculpt"
    },
    {
      "source": "/navigator",
      "destination": "/api/hub-page?tool=navigator"
    },
    {
      "source": "/navigator/",
      "destination": "/api/hub-page?tool=navigator"
    },
    {
      "source": "/vault",
      "destination": "/api/hub-page?tool=vault"
    },
    {
      "source": "/vault/",
      "destination": "/api/hub-page?tool=vault"
    },
    {
      "source": "/certainty",
      "destination": "/api/hub-page?tool=certainty"
    },
    {
      "source": "/certainty/",
      "destination": "/api/hub-page?tool=certainty"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/seeninseven",
      "destination": "/admin-seeninseven.html"
    },
    {
      "source": "/admin/seeninseven/",
      "destination": "/admin-seeninseven.html"
    },
    {
      "source": "/admin/seeninseven/prompt-tester",
      "destination": "/admin-prompt-tester.html"
    },
    {
      "source": "/admin/seeninseven/prompt-tester/",
      "destination": "/admin-prompt-tester.html"
    },
    {
      "source": "/admin/boardroom",
      "destination": "/admin-boardroom.html"
    },
    {
      "source": "/admin/boardroom/",
      "destination": "/admin-boardroom.html"
    },
    {
      "source": "/boardroom",
      "destination": "https://boardroom2.vercel.app/boardroom"
    },
    {
      "source": "/boardroom/:path*",
      "destination": "https://boardroom2.vercel.app/boardroom/:path*"
    },
    {
      "source": "/seeninseven",
      "destination": "/seeninseven.html"
    },
    {
      "source": "/seeninseven/",
      "destination": "/seeninseven.html"
    }
  ]
}
